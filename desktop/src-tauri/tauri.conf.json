{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SparRadar",
  "version": "1.0.0",
  "identifier": "de.sparradar.app",
  "build": {
    "frontendDist": "https://tiry38.github.io/sparradar/"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SparRadar",
    "shortDescription": "Angebote rund um Wörth am Rhein",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "displayLanguageSelector": false
      }
    }
  }
}
