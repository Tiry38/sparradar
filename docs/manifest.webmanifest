{
  "name": "SparRadar",
  "short_name": "SparRadar",
  "description": "Alle Angebote rund um Wörth am Rhein",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#16191C",
  "theme_color": "#16191C",
  "related_applications": [{ "platform": "webapp", "url": "https://tiry38.github.io/sparradar/manifest.webmanifest" }],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "bon",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            "text/plain",
            "text/*",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Einkaufszettel",
      "short_name": "Zettel",
      "description": "Einkaufszettel öffnen",
      "url": "./?go=list",
      "icons": [
        {
          "src": "sc-list.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        },
        {
          "src": "sc-list.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "maskable"
        }
      ]
    },
    {
      "name": "Auf den Zettel scannen",
      "short_name": "Scannen",
      "description": "Artikel per Strichcode auf den Einkaufszettel setzen",
      "url": "./?go=scan",
      "icons": [
        {
          "src": "sc-scan.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        },
        {
          "src": "sc-scan.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "maskable"
        }
      ]
    },
    {
      "name": "Merkliste",
      "short_name": "Merkliste",
      "description": "Merkliste mit Treffern öffnen",
      "url": "./?go=watch",
      "icons": [
        {
          "src": "sc-watch.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        },
        {
          "src": "sc-watch.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "maskable"
        }
      ]
    }
  ]
}